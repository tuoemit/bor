{
  "name": "browser-panel",
  "version": "1.2.0",
  "private": true,
  "description": "Password-protected remote browser panel. Server-side HTTP reverse proxy + iframe webview (no Chromium). Deploys to Render or Railway.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "servo:install": "node scripts/install-servo.js",
    "servo:version": "node -e \"console.log(require('child_process').execFileSync(process.env.SERVO_BIN||'./bin/servo-fetch',['--version']).toString())\""
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.6.3",
    "sql.js": "^1.13.0"
  }
}
