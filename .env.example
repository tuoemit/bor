# Copy to .env for local runs, or paste into the Railway / Render dashboard.

# REQUIRED. Password that unlocks the panel.
APP_PASSWORD=change-me-please

# Optional. Signing key for session cookies (set it so changing the password
# doesn't log you out).
# SESSION_SECRET=

# Optional. Login lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# Optional. SQLite path. On Railway mount a volume at /data so history,
# bookmarks and cookies survive redeploys.
DB_PATH=./data/browser.db

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
# chromium (default) = live Chromium is the primary engine for new tabs,
#                      with the lightweight proxy available per tab.
# proxy              = never launch Chromium at all.
# APP_ENGINE=chromium

# CHROMIUM_ENABLED=1
# CHROMIUM_ARGS=--disable-webkit-font-smoothing

# MEASURED memory cost: one real tab is ~925 MB of browser processes plus
# ~150 MB of Node. Below this limit the engine refuses to start and the panel
# explains why. Railway: Settings -> Resources -> 2 GB.
# CHROMIUM_MIN_MEMORY_MB=1800

# Max live tabs. Each extra tab costs roughly 80-150 MB.
# MAX_BROWSER_TABS=3

# Suspend a tab after this long off-screen, and stop the whole engine after
# this long with no tabs. Frees ~900 MB when you walk away.
# TAB_SLEEP_MS=900000
# BROWSER_IDLE_SHUTDOWN_MS=600000

# Virtual screen the pages are laid out at.
# BROWSER_WIDTH=1280
# BROWSER_HEIGHT=800

# JPEG quality of the stream (40-80 sensible; lower = less bandwidth).
# BROWSER_JPEG_QUALITY=62

# Per-navigation timeout, and JS heap cap per renderer.
# BROWSER_NAV_TIMEOUT_MS=45000
# BROWSER_HEAP_MB=512

# Drop frames rather than queue them when the socket is backed up (bytes).
# BROWSER_SOCKET_BACKLOG=1500000

# ---------------------------------------------------------------------------
# Proxy engine / panel
# ---------------------------------------------------------------------------
# Max concurrent upstream requests per session (proxy mode).
# MAX_INFLIGHT_PER_SESSION=12
# UPSTREAM_TIMEOUT_MS=30000
# BLOCKED_HOSTS=example.com,internal.corp
# Widen only if the panel itself is embedded in another site's iframe.
# CSP_FRAME_ANCESTORS='self'
# LOG_LEVEL=info

# SSRF guard. Leave off on a cloud host: this is what keeps the platform
# metadata service (169.254.169.254) unreachable through the panel.
# ALLOW_PRIVATE_HOSTS=0
