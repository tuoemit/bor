# Copy to .env for local runs, or paste into the Render / Railway dashboard.

# REQUIRED. The password that unlocks the panel. If unset, a random one is
# generated at boot and printed to the logs (sessions reset on every restart).
APP_PASSWORD=change-me-please

# Optional. Signing key for session cookies. If unset it is derived from
# APP_PASSWORD. Set it if you want to change the password without logging out.
# SESSION_SECRET=

# Optional. How long a login lasts, in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# Optional. SQLite file path. Point this at a mounted volume to survive
# redeploys: Railway volume -> /data/browser.db, Render disk -> /data/browser.db
DB_PATH=./data/browser.db

# Optional. Port (Render/Railway inject PORT automatically).
# PORT=8080

# Optional. Upstream request timeout in ms (default 30000).
# UPSTREAM_TIMEOUT_MS=30000

# Optional. Comma-separated hosts this proxy may never reach.
# BLOCKED_HOSTS=example.com,internal.corp

# Optional. Set to 1 to allow proxying to private/loopback IPs.
# DANGEROUS on a cloud host: this is what protects the platform metadata
# service (169.254.169.254) from being reachable through the panel.
# ALLOW_PRIVATE_HOSTS=0

# Optional. Max concurrent upstream requests per session (default 12).
# MAX_INFLIGHT_PER_SESSION=12
