# ------------------------------------------------------------------ #
# Core secrets -- set these on the platform (Render/Railway dashboard)
# or in a local .env for development.                                  #
# ------------------------------------------------------------------ #

# Required. The password that unlocks the panel. If missing, login returns 500
# "not_configured" and the login page tells you so.
PANEL_PASSWORD=change-me

# Long random string. Signs the session cookie. If omitted one is generated per
# boot, which logs everyone out on every restart/deploy.
SESSION_SECRET=

# Optional. Lets curl/cron call /api/* with `Authorization: Bearer <token>`
# instead of a browser cookie. Leave empty to disable.
API_TOKEN=

# ------------------------------------------------------------------ #
# Server                                                              #
# ------------------------------------------------------------------ #
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Both platforms sit behind a proxy; keep true so client IPs/secure cookies work.
TRUST_PROXY=true
# Set false on Render/Railway only if TLS terminates elsewhere without https.
SECURE_COOKIES=true
SESSION_TTL_HOURS=12

# ------------------------------------------------------------------ #
# Browser engine (Firefox / Gecko -- there is no Chromium here)       #
# ------------------------------------------------------------------ #
HEADLESS=true
# Where saved profiles + downloads live. Mount a volume at this path on the
# platform if you want them to survive restarts.
DATA_DIR=
MAX_TABS=4
MAX_SESSIONS=3
TAB_IDLE_TIMEOUT_MS=1200000
BROWSER_LAUNCH_TIMEOUT_MS=60000
NAV_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=20000

# Viewport / screencast (phone-sized by default for a mobile layout + fast frames)
VIEWPORT_WIDTH=412
VIEWPORT_HEIGHT=840
DEVICE_SCALE_FACTOR=1
FRAME_QUALITY=58
FRAME_INTERVAL_MS=250

# Behaviour
IGNORE_HTTPS_ERRORS=true
BYPASS_CSP=false
USER_AGENT=
LOCALE=en-US
TIMEZONE=UTC

# Automation
SCRIPT_MAX_STEPS=60
SCRIPT_TIMEOUT_MS=120000

# Set 1 to not launch Firefox at boot (saves a little RAM until first use).
LAZY_BROWSER=0
LOG_LEVEL=info
